          "value": "(\"analytics\".\"usage_event\".\"event\" = 'app_close') = (\"analytics\".\"usage_event\".\"duration_s\" IS NOT NULL) AND (\"analytics\".\"usage_event\".\"duration_s\" IS NULL OR \"analytics\".\"usage_event\".\"duration_s\" BETWEEN 0 AND 86400)"
