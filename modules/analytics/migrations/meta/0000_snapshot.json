        "ck_usage_event_name": {
          "name": "ck_usage_event_name",
          "value": "char_length(\"analytics\".\"usage_event\".\"name\") <= 60 AND \"analytics\".\"usage_event\".\"name\" ~ '^[A-Z][A-Za-z0-9-]*(\\.[a-z][a-z0-9_]*)?$'"
        },
        "ck_usage_event_name_form": {
          "name": "ck_usage_event_name_form",
          "value": "(\"analytics\".\"usage_event\".\"event\" = 'tap') = (position('.' IN \"analytics\".\"usage_event\".\"name\") > 0)"
        },
        "ck_usage_event_lifecycle": {
          "name": "ck_usage_event_lifecycle",
          "value": "(\"analytics\".\"usage_event\".\"event\" = 'app_open' AND \"analytics\".\"usage_event\".\"name\" IN ('Launch', 'Resume')) OR (\"analytics\".\"usage_event\".\"event\" = 'app_close' AND \"analytics\".\"usage_event\".\"name\" = 'Background') OR \"analytics\".\"usage_event\".\"event\" IN ('screen_view', 'tap')"
        },
