        "ck_events_id_v7": {
          "name": "ck_events_id_v7",
          "value": "uuid_extract_version(\"realtime\".\"events\".\"id\") = 7"
        },
        "ck_events_type": {
          "name": "ck_events_type",
          "value": "\"realtime\".\"events\".\"type\" IN ('inbox.created', 'ticket.created', 'ticket.changed', 'money_log.opened', 'export.ready', 'session.revoked')"
        },
        "ck_events_target": {
          "name": "ck_events_target",
          "value": "(\"realtime\".\"events\".\"target_account_id\" IS NULL) <> (\"realtime\".\"events\".\"target_roles\" IS NULL)"
        },
        "ck_events_roles": {
          "name": "ck_events_roles",
          "value": "\"realtime\".\"events\".\"target_roles\" IS NULL OR (cardinality(\"realtime\".\"events\".\"target_roles\") >= 1 AND \"realtime\".\"events\".\"target_roles\" <@ ARRAY['admin', 'manager', 'technician', 'guard'])"
        },
        "ck_events_close": {
          "name": "ck_events_close",
          "value": "(\"realtime\".\"events\".\"close_session_id\" IS NOT NULL) = (\"realtime\".\"events\".\"type\" = 'session.revoked')"
        },
        "ck_events_data": {
          "name": "ck_events_data",
          "value": "jsonb_typeof(\"realtime\".\"events\".\"data\") = 'object' AND octet_length(\"realtime\".\"events\".\"data\"::text) <= 2048"
        }
      },
