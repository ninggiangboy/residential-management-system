    "@mod/building": "workspace:*",
    "@mod/residency": "workspace:*",
    "@rms/i18n-catalog": "workspace:*",
    "@rms/shared-types": "workspace:*",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@core/testing": "workspace:*",
    "@rms/test-support": "workspace:*",
    "@types/bun": "1.4.3",
    "drizzle-kit": "0.31.11",
    "postgres": "3.4.9"
  }
