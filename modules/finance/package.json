{
  "name": "@mod/finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "bun": "./src/contracts/index.ts",
      "types": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./manifest": {
      "bun": "./src/manifest.ts",
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./schema": {
      "bun": "./src/infrastructure/persistence/schema.ts",
      "types": "./src/infrastructure/persistence/schema.ts",
      "default": "./src/infrastructure/persistence/schema.ts"
    },
    "./integrations/building": {
      "bun": "./src/integrations/building/index.ts",
      "types": "./src/integrations/building/index.ts",
      "default": "./src/integrations/building/index.ts"
    },
    "./integrations/residency": {
      "bun": "./src/integrations/residency/index.ts",
      "types": "./src/integrations/residency/index.ts",
      "default": "./src/integrations/residency/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src --pass-with-no-tests",
