{
  "name": "residential-management-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter './apps/*' --filter './modules/*' --filter './packages/*' typecheck && tsc --project scripts",
    "test": "bun run --filter './apps/*' --filter './modules/*' --filter './packages/*' test",
    "check:arch": "bun scripts/check-arch.ts",
    "check:arch:fixtures": "bun test tools/arch-fixtures",
    "quality:unused": "knip",
    "quality:dup": "jscpd",
    "check": "bun scripts/check.ts",
    "check:commits": "bun scripts/check-commits.ts",
    "check:test-ids": "bun scripts/check-test-ids.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "dependabot:sync": "bun scripts/dependabot-sync.ts",
    "check:dependabot": "bun scripts/dependabot-sync.ts --check",
    "test:coverage": "bun scripts/coverage-report.ts",
    "db:provision-ci": "bun scripts/db-provision-ci.ts",
    "docker:build": "docker build --file docker/Dockerfile.api --tag rms-api:local .",
    "check:compat": "bun test tools/compat",
    "check:tools": "bun scripts/check-tools.ts",
    "keys:generate": "bun scripts/keys-generate.ts",
    "infra:up": "bun scripts/infra.ts up",
    "infra:down": "bun scripts/infra.ts down",
    "infra:reset": "bun scripts/infra.ts reset",
    "setup": "bun scripts/setup.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "exceljs": "4.4.0",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "typescript": "7.0.2"
  }
}
