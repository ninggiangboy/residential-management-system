{
  "name": "residential-management-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "scripts": {
    "api": "bun run --cwd apps/api dev",
    "web": "bun run --cwd apps/cms-web dev",
    "rapp": "bun run --cwd apps/resident-app start",
    "sapp": "bun run --cwd apps/staff-app start",
    "dev:resident": "bun run rapp",
    "dev:staff": "bun run sapp",
    "dev": "bun scripts/dev.ts start",
    "dev:api": "bun run api",
    "stop": "bun scripts/dev.ts stop",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter './apps/*' --filter './modules/*' --filter './packages/*' typecheck && tsc --project scripts && tsc --project tools/ops-files",
    "test": "bun run --filter './apps/*' --filter './modules/*' --filter './packages/*' test",
    "check:arch": "bun scripts/check-arch.ts",
    "check:arch:fixtures": "bun test tools/arch-fixtures",
    "check:scope": "bun scripts/check-scope.ts && bun test tools/scope-lint",
    "check:audit": "bun scripts/check-audit.ts && bun test tools/audit-lint",
    "check:layout": "bun scripts/check-layout.ts && bun test tools/layout-lint",
    "check:authz-metadata": "bun run --cwd apps/api check:authz-metadata",
    "quality:unused": "knip",
    "quality:dup": "jscpd",
    "check:i18n": "bun test packages/i18n-catalog",
    "check": "bun scripts/check.ts",
    "check:commits": "bun scripts/check-commits.ts",
    "pr:merge": "bun scripts/merge-pr.ts",
    "staging:push": "bun scripts/staging-push.ts",
    "check:test-ids": "bun scripts/check-test-ids.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "dependabot:sync": "bun scripts/dependabot-sync.ts",
    "check:dependabot": "bun scripts/dependabot-sync.ts --check",
    "check:ops": "bun scripts/check-ops.ts",
    "check:deploy": "bun scripts/check-deploy.ts",
    "test:backup-repo": "bun test tools/ops-files/backup-repo.test.ts",
    "ops:dashboards": "bun scripts/build-dashboards.ts",
    "test:coverage": "bun scripts/coverage-report.ts",
    "db:provision-ci": "bun scripts/db-provision-ci.ts",
    "docker:build": "docker build --file docker/Dockerfile.api --tag rms-api:local .",
    "check:compat": "bun test tools/compat",
    "tokens:build": "bun packages/design-tokens/scripts/build.ts",
    "check:tools": "bun scripts/check-tools.ts",
    "keys:generate": "bun scripts/keys-generate.ts",
    "secrets:push": "bun scripts/secrets-push.ts",
    "infra:up": "bun scripts/infra.ts up",
    "infra:down": "bun scripts/infra.ts down",
    "infra:reset": "bun scripts/infra.ts reset",
    "monitor:up": "docker compose -f docker/compose.local.yml --env-file .env.local --profile monitoring up -d --wait --wait-timeout 120 prometheus alertmanager loki alloy grafana postgres-exporter node-exporter",
    "monitor:down": "docker compose -f docker/compose.local.yml --env-file .env.local --profile monitoring rm -sf prometheus alertmanager loki alloy grafana postgres-exporter node-exporter",
    "setup": "bun scripts/setup.ts",
    "prepare": "husky || true",
    "dev:web": "bun run --filter @app/cms-web dev",
    "build": "bun run --filter @app/cms-web build && bun run --filter @app/resident-app --filter @app/staff-app typecheck",
    "db:migrate": "bun --env-file=.env.local scripts/migrate.ts",
    "db:generate": "bun --env-file=.env.local scripts/db.ts generate",
    "db:reset": "bun --env-file=.env.local scripts/db.ts reset",
    "seed:demo": "bun run --cwd apps/api seed:demo",
    "test:grants": "bun run --cwd apps/api test:grants",
    "test:authz": "bun run --cwd apps/api test:authz",
    "exp:10": "bun run --cwd apps/api exp:10",
    "config:example": "bun run --cwd apps/api config:example",
    "test:integration": "bun run --filter './apps/*' --filter './modules/*' test:integration",
    "test:mobile": "maestro test apps/resident-app/.maestro && maestro test apps/staff-app/.maestro",
    "test:e2e": "bun run --filter @app/cms-web e2e",
    "test:db-clean": "bun --env-file=.env.local packages/test-support/src/db-clean.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/node": "4.3.3",
    "@types/bun": "1.4.3",
    "drizzle-kit": "0.31.11",
    "exceljs": "4.4.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "nativewind": "4.2.7",
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "react-native-css-interop": "0.2.7",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2"
  }
}
