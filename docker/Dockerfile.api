# syntax=docker/dockerfile:1.28.0
# The `rms-api` image (DOC-71 §6.1): one image for both roles (`APP_ROLES`, DR-05), linux/amd64 only.
FROM oven/bun:1.4.3 AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
# Every workspace manifest, so `--frozen-lockfile` sees the workspaces of `bun.lock`; `--parents` keeps the paths and
# needs no line per module (Dockerfile 1.20+).
COPY --parents apps/*/package.json modules/*/package.json packages/*/package.json ./
RUN bun install --frozen-lockfile --production --filter @app/api

FROM oven/bun:1.4.3 AS runtime
RUN groupadd --gid 10001 rms && useradd --uid 10001 --gid rms --no-create-home --shell /usr/sbin/nologin rms
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bunfig.toml ./
COPY apps/api ./apps/api
COPY modules ./modules
COPY packages ./packages
# `scripts/migrate.ts` (P1-06) and `scripts/keys-generate.ts --out` (P1-04) join this line when they exist.
COPY scripts/healthcheck.ts ./scripts/
ARG GIT_SHA=unknown
# The repository URL comes from CI (`github.server_url`/`github.repository`): no Owner value in the repository (DR-228).
ARG SOURCE_URL=unknown
LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${GIT_SHA}"
ENV NODE_ENV=production
USER rms
EXPOSE 3000 3001
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 CMD ["bun", "scripts/healthcheck.ts"]
CMD ["bun", "apps/api/src/main.ts"]
