# syntax=docker/dockerfile:1.28.0
# The `rms-api` image (DOC-71 §6.1): one image for both roles (`APP_ROLES`, DR-05), linux/amd64 only.
FROM oven/bun:1.4.4 AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
# The patches of `patchedDependencies`, which `bun install` applies (DR-278).
COPY patches ./patches
# Every workspace manifest, so `--frozen-lockfile` sees the workspaces of `bun.lock`; `--parents` keeps the paths and
# needs no line per module (Dockerfile 1.20+).
COPY --parents apps/*/package.json modules/*/package.json packages/*/package.json ./
# `--omit=peer`: Bun installs optional peers, and Elysia's (`typescript`, `@types/bun`) would put the TypeScript 7 Go
# binary in the image; the peers Elysia needs at run time are direct dependencies of `@app/api`.
RUN bun install --frozen-lockfile --production --omit=peer --filter @app/api

FROM oven/bun:1.4.4 AS runtime
RUN groupadd --gid 10001 rms && useradd --uid 10001 --gid rms --no-create-home --shell /usr/sbin/nologin rms
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bunfig.toml ./
COPY apps/api ./apps/api
COPY modules ./modules
COPY packages ./packages
# `keys-generate.ts --out` makes the secret files on the staging host (DOC-70 §9.1). `migrate.ts` reads the bootstrap and grants SQL (DOC-19 §3.1); `maintenance.ts` sets the maintenance flag (DOC-70 §6.4).
COPY scripts/healthcheck.ts scripts/migrate.ts scripts/maintenance.ts scripts/keys-generate.ts ./scripts/
COPY scripts/lib/env.ts scripts/lib/keys.ts ./scripts/lib/
COPY ops/postgres/0000-bootstrap.sql ops/postgres/0900-grants.sql ./ops/postgres/
ARG GIT_SHA=unknown
# The repository URL comes from CI (`github.server_url`/`github.repository`): no Owner value in the repository (DR-228).
ARG SOURCE_URL=unknown
LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${GIT_SHA}"
ENV NODE_ENV=production
USER rms
EXPOSE 3000 3001
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 CMD ["bun", "scripts/healthcheck.ts"]
CMD ["bun", "apps/api/src/main.ts"]
