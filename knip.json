{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "tools/arch-fixtures/*.test.ts",
        "tools/compat/*.test.ts",
        "tools/scope-lint/*.test.ts",
        "tools/audit-lint/*.test.ts",
        "tools/layout-lint/*.test.ts"
      ],
      "project": [
        "scripts/*.ts",
        "tools/arch-fixtures/*.ts",
        "tools/compat/*.ts",
        "tools/scope-lint/*.ts",
        "tools/audit-lint/*.ts",
        "tools/layout-lint/*.ts"
      ],
      "ignoreDependencies": ["drizzle-kit"],
      "ignoreBinaries": ["maestro"]
    },
    "apps/api": {
      "entry": [
        "src/bootstrap/module-catalog.ts",
        "scripts/*.ts",
        "src/**/*.test.ts",
        "tests/**/*.test.ts",
        "tests/integration/relay-worker.ts"
      ],
      "project": ["src/**/*.ts", "scripts/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["drizzle-orm", "postgres"]
    },
    "packages/shared-types": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/resident-app": {
      "entry": ["app/**/*.{ts,tsx}", "*.config.js", "app.config.ts", "src/**/*.test.ts"],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "*.config.js", "app.config.ts"],
      "expo": false,
      "metro": false,
      "babel": false,
      "tailwind": false,
      "ignoreDependencies": [
        "@react-native-async-storage/async-storage",
        "@react-native-community/netinfo",
        "expo-device",
        "expo-localization",
        "expo-notifications",
        "expo-secure-store",
        "react-native-svg",
        "expo-dev-client"
      ]
    },
    "apps/staff-app": {
      "entry": ["app/**/*.{ts,tsx}", "*.config.js", "app.config.ts", "src/**/*.test.ts"],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "*.config.js", "app.config.ts"],
      "expo": false,
      "metro": false,
      "babel": false,
      "tailwind": false,
      "ignoreDependencies": [
        "@react-native-async-storage/async-storage",
        "@react-native-community/netinfo",
        "expo-device",
        "expo-localization",
        "expo-notifications",
        "expo-secure-store",
        "react-native-svg",
        "expo-dev-client"
      ]
    },
    "apps/cms-web": {
      "entry": ["src/**/*.test.ts", "e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/i18n-catalog": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/design-tokens": {
      "entry": ["src/**/*.test.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    },
    "packages/test-support": {
      "entry": ["src/db-clean.ts"],
      "project": ["src/**/*.ts"]
    },
    "modules/*": {
      "entry": ["src/**/*.test.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/mobile-core": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui-native": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["react-native-svg"]
    }
  },
  "rules": {
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn"
  }
}
