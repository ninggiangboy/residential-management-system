      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"rms-api\",status=~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count{job=\"rms-api\"}[5m]))",
