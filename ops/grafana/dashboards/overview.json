          "refId": "A",
          "expr": "min(readiness_ok{job=\"rms-api\"})",
          "legendFormat": ""
        }
      ],
      "description": "Supports: ReadinessFailing.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
