          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Gauges that failed to refresh",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (gauge) (increase(metrics_collection_errors_total[15m]))",
          "legendFormat": "{{gauge}}"
        }
      ],
      "description": "Supports: MetricsCollectionFailing.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
