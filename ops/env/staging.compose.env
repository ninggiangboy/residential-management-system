# /opt/rms/env/compose.env of staging (DOC-70 §6.1). Not secret: `ci-deploy.sh --prepare` fills ${DOMAIN} and ${GHCR_OWNER}
# (the repository owner, lower case) and the bootstrap installs it. Production gets its own file with P6-13 (RMS_ENV=production,
# COMPOSE_PROFILES=api2,logs, RMS_HOST_SUFFIX empty).
COMPOSE_PROJECT_NAME=rms
RMS_ENV=staging
COMPOSE_PROFILES=
RMS_GHCR_OWNER=${GHCR_OWNER}
RMS_DOMAIN=${DOMAIN}
RMS_HOST_SUFFIX=-staging
