# Generated from the config slices: run `bun run --cwd apps/api config:example` after changing one. Do not edit by hand.

# ---- Process and runtime (DOC-41 §4) ----
# The profile: local, test, staging or production. Never NODE_ENV.
APP_ENV=local
# Which parts start: `api` serves HTTP, `worker` runs the relay and the jobs.
# APP_ROLES=api,worker
# Kept from the vendored slice; the scaling unit is the container, so it stays 1.
# APP_PROCESSES=1
# HTTP port of `api`.
# PORT=3000
# `/health/*` and `/metrics`; never routed by Caddy or the Tunnel.
# OPS_PORT=3001
# pino level.
# LOG_LEVEL=info
# Proxies between the socket and the client (the client-IP rule of DOC-39 §5.3).
# TRUSTED_PROXY_HOPS=0
# Peers whose forwarding headers are believed.
# TRUSTED_PROXY_CIDRS=
# Poll of `platform.maintenance`.
# MAINTENANCE_POLL_INTERVAL_MS=1000
# The database ping of `/health/ready`.
# READINESS_DB_TIMEOUT_MS=2000
# Wait for running jobs at shutdown (`worker`).
# WORKER_STOP_TIMEOUT_SECONDS=40
# Zone of the clock jobs (`worker`); the process itself runs in UTC.
# JOBS_TIME_ZONE=Asia/Ho_Chi_Minh

# ---- Database (DOC-41 §5) ----
# Each URL has a `_FILE` form; in staging and production only that form is accepted.
# Role `rms_app`, DML only.
DATABASE_URL=
# Role `rms_migrator`; read only by the migration step, never mounted in `api` or `worker`.
# MIGRATION_DATABASE_URL=
# Role `rms_readonly`; read only by the exporter container.
# READONLY_DATABASE_URL=
# Connections per process; `OUTBOX_CONCURRENCY` is capped at this minus 4.
# DB_POOL_MAX=10
# Prepared statements; off keeps the code PgBouncer-safe.
# DB_PREPARE=false

# ---- Secrets and key rings (DOC-41 §6) ----
# Each has a `_FILE` form. A ring is `{"<kid>": "<key>"}`: the newest kid signs, all verify.
# ES256 private keys (PEM) by kid; signs and verifies access tokens (`api`).
# JWT_KEYS=
# Base64 32-byte keys by kid; signs and verifies QR tokens (`api`).
# QR_KEYS=
# Base64 of at least 32 bytes; HMAC of OTP and step-up codes (`api`).
# OTP_HMAC_KEY=
# AES-256-GCM ring of `gateway_config.secrets_enc` and command secrets.
# SETTINGS_ENCRYPTION_KEYS=
# AES-256-GCM ring of `resident_profile.cccd_enc` (`api`).
# PII_ENCRYPTION_KEYS=
# Files bucket access key.
# S3_ACCESS_KEY_ID=
# Files bucket secret key.
# S3_SECRET_ACCESS_KEY=
# Mail relay password (`worker` in staging and production).
# SMTP_PASSWORD=
# Expo push access token (`worker` in staging and production).
# EXPO_ACCESS_TOKEN=
# Password of the seeded demo staff; at least 12 characters.
# DEMO_STAFF_PASSWORD=

# ---- HTTP and API (DOC-41 §7) ----
# Origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
# Base of invite and reset links.
# ADMIN_BASE_URL=http://localhost:5173
# Link in the invitation SMS.
# APP_DOWNLOAD_URL=
# Below it the API answers 426 `upgrade_required` (resident app).
# MIN_APP_VERSION_RESIDENT=1.0.0
# Below it the API answers 426 `upgrade_required` (staff app).
# MIN_APP_VERSION_STAFF=1.0.0
# Store link of the resident app on iOS.
# STORE_URL_RESIDENT_IOS=
# Store link of the resident app on Android.
# STORE_URL_RESIDENT_ANDROID=
# Store link of the staff app on iOS.
# STORE_URL_STAFF_IOS=
# Store link of the staff app on Android.
# STORE_URL_STAFF_ANDROID=
# Retention of `platform.idempotency_key`.
# IDEMPOTENCY_TTL_HOURS=24
# Body limit when Caddy is absent (local, test).
# API_BODY_LIMIT_BYTES=2097152
# OpenAPI and Scalar at `/api/v1/openapi.json` and `/api/v1/docs`; refused in production.
# OPENAPI_ENABLED=true
# Process cache of the building settings.
# SETTINGS_CACHE_SECONDS=60
# Ticket deadlines.
# FEATURE_TICKET_DEADLINES=false
# `POST /client-errors` per IP.
# CLIENT_ERRORS_PER_MINUTE_PER_IP=10
# `POST /client-errors` per account.
# CLIENT_ERRORS_PER_HOUR_PER_ACCOUNT=30

# ---- Identity and sessions (DOC-41 §8) ----
# Access token lifetime.
# ACCESS_TOKEN_TTL_SECONDS=900
# Sliding refresh lifetime of a staff session.
# REFRESH_TTL_DAYS_STAFF=30
# Sliding refresh lifetime of a resident session.
# REFRESH_TTL_DAYS_RESIDENT=180
# Absolute lifetime of a staff refresh family.
# FAMILY_MAX_DAYS_STAFF=90
# Absolute lifetime of a resident refresh family.
# FAMILY_MAX_DAYS_RESIDENT=365
# Live sessions per account; the oldest is evicted.
# MAX_FAMILIES_PER_ACCOUNT=10
# Window in which a rotated token is accepted once more.
# REFRESH_GRACE_SECONDS=10
# Argon2id memory cost.
# ARGON2_MEMORY_KIB=19456
# Argon2id time cost.
# ARGON2_TIME_COST=2
# Invitation link lifetime.
# INVITE_TTL_HOURS=24
# Password reset link lifetime.
# RESET_TTL_MINUTES=30
# Step-up code lifetime.
# STEPUP_TTL_MINUTES=10
# Wrong step-up codes before the code dies.
# STEPUP_MAX_ATTEMPTS=5
# Step-up code requests per staff member.
# STEPUP_REQUESTS_PER_HOUR=5
# OTP lifetime.
# OTP_TTL_SECONDS=300
# Earliest resend of an OTP.
# OTP_RESEND_AFTER_SECONDS=45
# Wrong OTP codes before the challenge ends.
# OTP_MAX_ATTEMPTS=5
# OTP requests per phone per hour.
# OTP_PER_PHONE_PER_HOUR=5
# OTP requests per IP per hour.
# OTP_PER_IP_PER_HOUR=20
# SMS per day for the whole deployment.
# OTP_DAILY_CAP=3000
# Staff sign-in attempts per IP per 15 minutes.
# STAFF_LOGIN_PER_IP=30
# Password reset requests per email per hour.
# RESET_PER_EMAIL_PER_HOUR=3
# Password reset requests per IP per hour.
# RESET_PER_IP_PER_HOUR=10
# Floor of the reset-request answer time.
# RESET_MIN_RESPONSE_MS=150
# Failing commands that mark the SMS provider down.
# SMS_DOWN_FAILURES=3
# Invitations an owner may send per building day.
# MEMBER_INVITES_PER_DAY=10

# ---- Notification drivers (DOC-41 §9) ----
# `provider` is required in production.
# SMS_DRIVER=console
# `smtp` is required in production.
# MAIL_DRIVER=console
# Phones that may receive a real SMS (staging).
# SMS_ALLOWLIST=
# Addresses that may receive a real mail (staging).
# MAIL_ALLOWLIST=
# Registered sender text; required in production.
# SMS_BRAND=
# Mail relay host; required when `MAIL_DRIVER=smtp`.
# SMTP_HOST=
# Mail relay port.
# SMTP_PORT=587
# Mail relay user; required when `MAIL_DRIVER=smtp`.
# SMTP_USER=
# From address of every mail; required when `MAIL_DRIVER=smtp`.
# MAIL_FROM=

# ---- Files: S3 and uploads (DOC-41 §10) ----
# Where the API reaches the bucket (the SeaweedFS S3 gateway in `vn` and locally; the R2 account endpoint in `global`, DR-268).
# S3_ENDPOINT=
# What clients are told; defaults to `S3_ENDPOINT`.
# S3_PUBLIC_ENDPOINT=
# Bucket region.
# S3_REGION=auto
# Bucket name; defaults to `rms-<APP_ENV>-files`.
# S3_BUCKET=
# `true` for the local object store.
# S3_FORCE_PATH_STYLE=false
# Presigned PUT lifetime.
# FILES_UPLOAD_URL_TTL_SECONDS=900
# Presigned GET lifetime.
# FILES_DOWNLOAD_URL_TTL_SECONDS=900
# Presigned GET lifetime of a vehicle paper.
# FILES_PAPER_URL_TTL_SECONDS=300
# Maximum image upload.
# FILES_MAX_IMAGE_BYTES=10485760
# Maximum video upload.
# FILES_MAX_VIDEO_BYTES=52428800
# Maximum attachment upload.
# FILES_MAX_ATTACHMENT_BYTES=20971520
# Maximum import file.
# FILES_MAX_IMPORT_BYTES=5242880
# Maximum building logo.
# FILES_MAX_LOGO_BYTES=1048576
# Ceiling of a generated file.
# FILES_GENERATED_MAX_BYTES=1073741824
# Thumbnail width in pixels.
# FILES_THUMBNAIL_WIDTH=480
# Logo width in pixels.
# FILES_LOGO_WIDTH=512
# Age at which an unattached upload is deleted.
# FILES_ORPHAN_AFTER_HOURS=24
# How long a deleted file row is kept.
# FILES_DELETED_ROW_RETENTION_DAYS=90
# How long a bulk zip is kept.
# FILES_BULK_ZIP_DAYS=7
# Bucket `upload:account:<id>`.
# UPLOAD_RATE_PER_HOUR=60

# ---- Jobs and outbox (DOC-41 §11) ----
# Sleep when a pass found nothing.
# OUTBOX_POLL_INTERVAL_MS=500
# Rows claimed per source per pass.
# OUTBOX_BATCH_SIZE=50
# Aggregate groups in parallel; at most `DB_POOL_MAX` minus 4.
# OUTBOX_CONCURRENCY=4
# Lease of a claim.
# OUTBOX_LEASE_SECONDS=60
# Attempts of an ordinary message.
# OUTBOX_MAX_ATTEMPTS=8
# Attempts of an SMS command.
# OUTBOX_SMS_MAX_ATTEMPTS=3
# Attempts of a push command.
# OUTBOX_PUSH_MAX_ATTEMPTS=3
# Attempts of an intent cancellation.
# OUTBOX_INTENT_CANCEL_MAX_ATTEMPTS=8
# `min(base × 2^(attempts − 1), max)`.
# OUTBOX_BACKOFF_BASE_SECONDS=5
# Ceiling of the back-off.
# OUTBOX_BACKOFF_MAX_SECONDS=900
# How long a `RetryLaterError` may defer a message.
# OUTBOX_DEFER_BUDGET_HOURS=24
# Published outbox rows and delivered inbox rows are kept this long.
# OUTBOX_RETENTION_DAYS=7
# Cleanup pass.
# OUTBOX_CLEANUP_INTERVAL_MINUTES=10
# Writer wrapper limit.
# OUTBOX_MAX_PAYLOAD_BYTES=65536
# Wake-up of the scheduler; "on time" is two ticks.
# JOBS_SCHEDULER_TICK_SECONDS=15
# Age at which `token_purge` deletes `job_run` rows.
# JOB_RUN_RETENTION_DAYS=30
# Catch-up window of the `invariant_check` clock job; 0 = none.
# JOB_INVARIANT_CHECK_GRACE_MINUTES=720
# Catch-up window of the `qr_scan_purge` clock job; 0 = none.
# JOB_QR_SCAN_PURGE_GRACE_MINUTES=720
# Catch-up window of the `otp_purge` clock job; 0 = none.
# JOB_OTP_PURGE_GRACE_MINUTES=720
# Catch-up window of the `token_purge` clock job; 0 = none.
# JOB_TOKEN_PURGE_GRACE_MINUTES=720
# Catch-up window of the `account_deletion` clock job; 0 = none.
# JOB_ACCOUNT_DELETION_GRACE_MINUTES=720
# Catch-up window of the `demo_reset` clock job; 0 = none.
# JOB_DEMO_RESET_GRACE_MINUTES=120
# Catch-up window of the `integrity_weekly` clock job; 0 = none.
# JOB_INTEGRITY_WEEKLY_GRACE_MINUTES=1440
# Catch-up window of the `integrity_notices` clock job; 0 = none.
# JOB_INTEGRITY_NOTICES_GRACE_MINUTES=1440
# Catch-up window of the `inbox_purge` clock job; 0 = none.
# JOB_INBOX_PURGE_GRACE_MINUTES=1440
# Catch-up window of the `import_purge` clock job; 0 = none.
# JOB_IMPORT_PURGE_GRACE_MINUTES=1440
# Catch-up window of the `finance_purge` clock job; 0 = none.
# JOB_FINANCE_PURGE_GRACE_MINUTES=1440
# Catch-up window of the `audit_purge` clock job; 0 = none.
# JOB_AUDIT_PURGE_GRACE_MINUTES=10080

# ---- Concurrency of the worker (DOC-41 §12) ----
# PDFs rendered at once.
# PDF_CONCURRENCY=1
# Exports streamed at once.
# EXPORT_CONCURRENCY=2

# ---- Observability (DOC-41 §13) ----
# Time a database-derived gauge may take at a scrape.
# METRICS_QUERY_TIMEOUT_MS=1500
# A gauge computed less than this long ago is reused.
# METRICS_CACHE_SECONDS=10

# ---- Keys of later phases (DOC-41 §14) ----
# Source ranges of the payment gateway; empty = no check.
# WEBHOOK_KNOWN_IPS=
# Rate of inserts into `finance.webhook_rejection` per IP.
# WEBHOOK_PER_MINUTE_PER_IP=60
# Body limit of the webhook route.
# WEBHOOK_MAX_BODY_BYTES=16384
# Excerpt stored with a rejection.
# WEBHOOK_REJECTION_EXCERPT_BYTES=2048
# Life of a payment intent.
# INTENT_TTL_MINUTES=60
# Intents claimed per tick of `intent_requery`.
# INTENT_REQUERY_BATCH=20
# A `creating` intent older than this is cleaned.
# INTENT_CREATING_STALE_SECONDS=120
# Concurrent gateway calls of the re-query job.
# GATEWAY_CALLS_IN_FLIGHT=5
# Bucket `intent:account:<id>`.
# INTENT_CREATE_PER_MINUTE=10
# Bucket `reminder:account:<id>`.
# DEBT_REMINDER_PER_HOUR=10
# Bucket `qr:account:<id>`.
# QR_ISSUE_PER_MINUTE=30
# Lifetime of a QR token.
# QR_TTL_SECONDS=900
# Recipients per fan-out transaction.
# NOTICE_FANOUT_BATCH=500
# Age of a `sending` heartbeat before a notice is reclaimed.
# NOTICE_RECLAIM_AFTER_MINUTES=5
# Messages per Expo request.
# PUSH_CHUNK_SIZE=100
# Age of a ticket before its receipt is read.
# PUSH_RECEIPT_DELAY_MINUTES=15
# Age at which `push_receipts` deletes tickets.
# PUSH_TICKET_RETENTION_DAYS=3
# Concurrent `GET /staff/events` streams per account.
# SSE_MAX_STREAMS_PER_ACCOUNT=3
# Must stay below 30 (Cloudflare closes a silent request after 100 s).
# SSE_HEARTBEAT_SECONDS=25
# Bank statement file.
# STATEMENT_MAX_BYTES=5242880
