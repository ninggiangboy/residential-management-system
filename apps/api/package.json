{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/app.ts",
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun --env-file=../../.env.local --watch src/main.ts",
    "start": "bun src/main.ts",
    "config:example": "bun scripts/config-example.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src --pass-with-no-tests",
    "test:integration": "bun --env-file=../../.env.local test tests/integration --timeout 30000 --pass-with-no-tests",
    "outbox:list": "bun --env-file=../../.env.local scripts/outbox.ts list",
    "outbox:requeue": "bun --env-file=../../.env.local scripts/outbox.ts requeue",
    "outbox:discard": "bun --env-file=../../.env.local scripts/outbox.ts discard",
    "seed:demo": "bun --env-file=../../.env.local scripts/seed-demo.ts",
    "jobs:run": "bun --env-file=../../.env.local scripts/jobs.ts",
    "check:authz-metadata": "bun tests/authz/check-metadata.ts",
    "test:authz": "bun --env-file=../../.env.local test tests/authz --timeout 300000 --pass-with-no-tests",
    "exp:10": "bun --env-file=../../.env.local tests/exp/exp10-authz-matrix.ts",
    "test:grants": "bun --env-file=../../.env.local test tests/grants --timeout 60000 --pass-with-no-tests"
  },
  "dependencies": {
    "@core/config": "workspace:*",
    "@core/db": "workspace:*",
    "@core/http": "workspace:*",
    "@core/kernel": "workspace:*",
    "@core/runtime": "workspace:*",
    "@core/telemetry": "workspace:*",
    "@core/storage": "workspace:*",
    "@mod/audit": "workspace:*",
    "@mod/building": "workspace:*",
    "@mod/identity": "workspace:*",
    "@mod/residency": "workspace:*",
    "@elysiajs/openapi": "1.4.16",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "file-type": "22.2.0",
    "openapi-types": "12.1.3",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@core/messaging": "workspace:*",
    "@core/testing": "workspace:*",
    "@rms/test-support": "workspace:*",
    "exceljs": "4.4.0"
  }
}
