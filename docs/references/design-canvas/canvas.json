  "notes": {
    "s-helper": {
      "fill": "teal",
      "page": "cu-dan",
      "text": "Giúp việc\n- Chỉ xem bản tin chung của BQL\n- Dùng mã QR của mình\n- Không có phí, yêu cầu, phương tiện, thành viên, tài liệu\n- Thanh tab chỉ còn Trang chủ, QR, Tài khoản",
      "w": 340,
      "x": 1880,
      "y": 7600
    },
    "s-member": {
      "fill": "orange",
      "page": "cu-dan",
      "text": "Thành viên gia đình (giả định, checklist chưa có loại này)\n- Như người thuê được trả phí\n- Xem danh sách thành viên, không quản lý\n- Khác người thuê ở nhãn vai trò\nCần chốt với khách",
      "w": 340,
      "x": 940,
      "y": 3400
    },
    "s-owner": {
      "fill": "teal",
      "page": "cu-dan",
      "text": "Chủ hộ\n- Xem và thanh toán phí\n- Tạo, theo dõi yêu cầu\n- Bản tin, tài liệu\n- Quản lý phương tiện\n- Quản lý thành viên: thêm, sửa, khóa, xóa (chỉ chủ hộ có)\n- Mã QR của mình",
      "w": 340,
      "x": 2350,
      "y": 1300
    },
    "s-s-bql1": {
      "fill": "teal",
      "page": "quan-ly",
      "text": "BQL\n- Trang chủ: phiếu mới, chưa phân công, xe chờ duyệt\n- Phân công Kỹ thuật hoặc Bảo vệ, thấy khối lượng việc từng người\n- Đổi trạng thái, ảnh kết quả, bình luận, ghi chú nội bộ\n- Đóng hoặc mở lại phiếu",
      "w": 340,
      "x": 2350,
      "y": 2000
    },
    "s-s-bql2": {
      "fill": "teal",
      "page": "quan-ly",
      "text": "BQL\n- Duyệt hoặc từ chối xe, xem ảnh xe, giấy đăng ký, số xe hiện có của căn\n- Soạn nhanh bản tin, chọn role nhận, xem tỷ lệ đã đọc\n- Tra căn, cư dân, gọi nhanh\n- Công nợ, link thanh toán là P2, chưa vẽ",
      "w": 340,
      "x": 3290,
      "y": 4300
    },
    "s-s-common": {
      "fill": "teal",
      "page": "quan-ly",
      "text": "Chung mọi role\n- Email + mật khẩu, tài khoản do Admin hoặc BQL tạo\n- Quên mật khẩu: gửi link, đổi trên trình duyệt\n- Không có đổi mật khẩu trong app\n- Thông báo, tài liệu theo quyền role, ngôn ngữ, push, đăng xuất",
      "w": 340,
      "x": 3760,
      "y": 0
    },
    "s-s-guard": {
      "fill": "teal",
      "page": "quan-ly",
      "text": "Bảo vệ\n- Quét QR động 15 phút: hiện căn, tên, vai trò, quyền\n- Mã hết hạn hoặc sai: báo lý do, không hiện thông tin\n- Tra biển số: chỉ xe đã duyệt\n- Xử lý phiếu được giao như Kỹ thuật\n- Xem phiếu Kỹ thuật, chỉ xem",
      "w": 340,
      "x": 4230,
      "y": 8700
    },
    "s-s-tech": {
      "fill": "teal",
      "page": "quan-ly",
      "text": "Kỹ thuật\n- Chỉ thấy phiếu được giao\n- Nhận việc hoặc từ chối kèm lý do (trả lại BQL)\n- Đã nhận → Đang xử lý → Hoàn thành\n- Ảnh trước/sau, ghi chú kết quả\n- Lịch sử và đánh giá của cư dân",
      "w": 340,
      "x": 2820,
      "y": 6400
    },
    "s-tenant": {
      "fill": "teal",
      "page": "cu-dan",
      "text": "Người thuê\n- Toàn quyền như chủ hộ, trừ quản lý thành viên\n- Được trả phí: dùng các màn Phí và thanh toán ở hàng bên dưới\n- Không được trả phí: xem phí, biên lai; không có nút thanh toán\n- Màn Căn hộ: giống hàng Thành viên gia đình",
      "w": 340,
      "x": 1410,
      "y": 5500
    },
    "s-w-admin": {
      "fill": "teal",
      "page": "web-cms",
      "text": "Admin\n- Toàn bộ quyền của BQL, cộng nhóm Hệ thống\n- Tài khoản nhân viên mọi role, gửi email đặt mật khẩu\n- Thông tin tòa nhà, hạn thanh toán mặc định\n- Cổng thanh toán (chưa chốt VNPay / VietQR)\n- Nhật ký thao tác, sao lưu, dung lượng",
      "w": 380,
      "x": 9360,
      "y": 9420
    },
    "s-w-bql1": {
      "fill": "teal",
      "page": "web-cms",
      "text": "BQL, phiếu hỗ trợ\n- Lọc theo trạng thái, loại, người phụ trách, thời gian\n- Phân công Kỹ thuật hoặc Bảo vệ, thấy khối lượng đang giữ\n- Bình luận với cư dân và ghi chú nội bộ tách riêng\n- Đóng / mở lại phiếu, loại phiếu song ngữ",
      "w": 380,
      "x": 7800,
      "y": 1600
    },
    "s-w-bql2": {
      "fill": "teal",
      "page": "web-cms",
      "text": "BQL, cư dân\n- Mỗi căn đúng 1 chủ hộ, BQL tạo bằng SĐT\n- SĐT đã có tài khoản thì liên kết thêm căn, không tạo trùng\n- Nhập Excel, báo lỗi theo dòng\n- Duyệt / từ chối xe kèm lý do, xem ảnh xe và giấy đăng ký",
      "w": 380,
      "x": 9360,
      "y": 3740
    },
    "s-w-bql3": {
      "fill": "teal",
      "page": "web-cms",
      "text": "BQL, nội dung\n- Bản tin song ngữ, chọn role nhận, gửi ngay hoặc hẹn giờ\n- Thống kê đã đọc và danh sách chưa đọc\n- Wiki: cây thư mục, quyền xem theo role, video, file đính kèm\n- Chỉ BQL và Admin được soạn",
      "w": 380,
      "x": 6240,
      "y": 5540
    },
    "s-w-bql4": {
      "fill": "teal",
      "page": "web-cms",
      "text": "BQL, tài chính\n- Đợt phí gắn \"phí của tháng nào\", nháp → phát hành → đóng\n- Nhập Excel, xem trước, sửa tay trước khi phát hành\n- Ghi nhận nộp thủ công, kể cả nộp một phần\n- Nhắc nợ bằng push, theo dõi giao dịch treo / trùng\n- Báo cáo chỉ phần thu",
      "w": 380,
      "x": 12480,
      "y": 7440
    },
    "s-w-common": {
      "fill": "teal",
      "page": "web-cms",
      "text": "Chung cho Admin và BQL\n- Đăng nhập email + mật khẩu, khóa tạm sau 5 lần sai\n- Quên mật khẩu: link qua email, đổi trên trình duyệt (dùng chung với App quản lý)\n- Hồ sơ cá nhân, ngôn ngữ Việt / Anh",
      "w": 380,
      "x": 6240,
      "y": 0
    },
