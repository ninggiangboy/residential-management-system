{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notices.notice_read.v1.schema.json",
  "title": "notices.notice_read.v1",
  "description": "Event of notices. A recipient opens a notice for the first time (FR-28.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "buildingId",
    "noticeId",
    "accountKind",
    "accountId",
    "readAt"
  ],
  "properties": {
    "buildingId": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The building. The first field of every payload."
    },
    "noticeId": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The notice."
    },
    "accountKind": {
      "$ref": "common.schema.json#/$defs/accountKind",
      "description": "Account kind."
    },
    "accountId": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The reader."
    },
    "readAt": {
      "$ref": "common.schema.json#/$defs/instant",
      "description": "First read time."
    }
  }
}
