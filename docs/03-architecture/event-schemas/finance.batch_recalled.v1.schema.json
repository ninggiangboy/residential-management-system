{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.batch_recalled.v1.schema.json",
  "title": "finance.batch_recalled.v1",
  "description": "Event of finance. Recall a published batch (FR-04).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "buildingId",
    "batchId",
    "code",
    "feeMonth",
    "part",
    "parts",
    "unitIds"
  ],
  "properties": {
    "buildingId": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The building. The first field of every payload."
    },
    "batchId": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The recalled batch."
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^PH-[0-9]{4}-[0-9]{2,}$",
      "description": "Batch code."
    },
    "feeMonth": {
      "$ref": "common.schema.json#/$defs/month",
      "description": "Fee month."
    },
    "part": {
      "type": "integer",
      "minimum": 1,
      "description": "Position of this message among the messages of one action, from 1."
    },
    "parts": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of messages the action wrote; the handler needs no other knowledge of the total."
    },
    "unitIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "description": "Units that had a non-void charge in the batch (DR-97), at most 500."
    }
  }
}
